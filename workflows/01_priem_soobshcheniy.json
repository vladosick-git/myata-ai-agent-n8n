          ]
        }
      },
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "Каждые 5 секунд",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "timeout",
              "value": "0"
            },
            {
              "name": "allowed_updates",
              "value": "[\"message\"]"
            }
          ]
        },
        "options": {
          "timeout": 2000
        }
      },
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Новые сообщения",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Берём новые сообщения, склеиваем подряд идущие сообщения одного клиента.\nconst updates = $input.first().json.result || [];\nif (!updates.length) return [];\nconst nextOffset = Math.max(...updates.map((u) => u.update_id)) + 1;\nconst chats = {};\nconst out = [];\nfor (const u of updates) {\n  const m = u.message;\n  if (!m || !m.chat) continue;\n  if (m.chat.type !== 'private') {\n    if ((m.text || '').startsWith('/chatid')) out.push({ json: { kind: 'chatid', chat_id: String(m.chat.id), next_offset: nextOffset } });\n    if ((m.text || '').startsWith('/otchet')) out.push({ json: { kind: 'report', chat_id: String(m.chat.id), next_offset: nextOffset } });\n    continue;\n  }\n  let text = m.text || m.caption || '';\n  if (!m.text) {\n    const what = m.photo ? 'фото' : m.voice ? 'голосовое сообщение' : m.video ? 'видео' : m.sticker ? 'стикер' : m.document ? 'файл' : m.contact ? 'контакт' : 'вложение';\n    text = (text ? text + ' ' : '') + '[клиент прислал ' + what + ', прочитать его нельзя]';\n    if (m.contact && m.contact.phone_number) text += ' Телефон из контакта: ' + m.contact.phone_number;\n  }\n  const id = String(m.chat.id);\n  if (!chats[id]) chats[id] = { kind: 'client', chat_id: id, first_name: m.from.first_name || '', username: m.from.username || '', text: text, message_id: m.message_id, next_offset: nextOffset };\n  else { chats[id].text += '\\n' + text; chats[id].message_id = m.message_id; }\n}\nout.push(...Object.values(chats).map((j) => ({ json: j })));\nif (!out.length) out.push({ json: { kind: 'skip', next_offset: nextOffset } });\nreturn out;"
      },
      "id": "00000000-0000-4000-8000-000000000003",
      "name": "Разобрать сообщения",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
