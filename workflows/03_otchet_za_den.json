    {
      "parameters": {
        "jsCode": "// Собираем итоговый текст отчёта.\nconst d = $('Данные за день').first().json;\nlet analysis = 'Сегодня обращений не было.';\nif (d.has_data) { try { analysis = String($('Разбор вопросов').first().json.text || '').trim(); } catch (e) { analysis = 'Разбор вопросов не получился, цифры выше посчитаны по журналу.'; } }\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst head = 'Диалогов: ' + d.dialogs + '\\nСообщений: ' + d.messages + '\\nЗаявок: ' + d.leads + '\\nПередано человеку: ' + d.handoffs;\nreturn [{ json: { ...d, report: head + '\\n\\n' + analysis, report_html: '📊 <b>Отчёт за ' + d.date + '</b>\\n' + esc(head) + '\\n\\n' + esc(analysis) } }];"
      },
