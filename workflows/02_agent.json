      "id": "00000000-0000-4000-8000-000000000013",
      "name": "База знаний",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        400,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "ЗАМЕНИТЬ",
